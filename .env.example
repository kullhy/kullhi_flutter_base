# Cloudflare Worker endpoint for IAP verification
CLOUDFLARE_WORKER_URL=https://api.yourworker.workers.dev

# IAP product ids (unique per app)
IAP_WEEKLY_ID=com.kullhi.appname.weekly
IAP_YEARLY_ID=com.kullhi.appname.yearly

# Shared secret key for worker request header App-Secret-Key
APP_SECRET_KEY=replace_with_secure_key

# Firebase app id (per app)
FIREBASE_APP_ID=1:1234567890:android:replace_me
